{
  "manifest_version": 3,
  "name": "AI Media Forensics Sentinel",
  "version": "1.0.0",
  "description": "Multi-pipeline AI forensics detector overlay for identifying synthetic and manipulated media on social platforms.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "AI Media Forensics"
  }
}
