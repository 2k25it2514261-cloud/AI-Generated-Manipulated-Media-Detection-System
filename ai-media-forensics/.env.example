# PostgreSQL Settings
POSTGRES_USER=forensics_user
POSTGRES_PASSWORD=forensics_password
POSTGRES_DB=forensics_db

# Backend Environment
ENVIRONMENT=development
DATABASE_URL=postgresql://forensics_user:forensics_password@localhost:5432/forensics_db
# For local dev without docker postgres, sqlite is supported:
# DATABASE_URL=sqlite:///./forensics.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_PATH=./storage

# Frontend API URL
VITE_API_URL=http://localhost:8000
